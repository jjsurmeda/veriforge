# infra/.env — the ONLY file with credentials in it. Copy to infra/.env,
# fill it in, and `chmod 600 infra/.env`. Every script refuses to run if the
# mode is not 600.
#
#   cp infra/.env.example infra/.env
#   chmod 600 infra/.env
#
# Values are never printed by any script. up.sh reports variable NAMES only.
#
# Three values are NOT here because up.sh generates them and holds them in SSM:
#   POSTGRES_PASSWORD   generated once; rotating it locks the instance out of
#                       its own data
#   JWT_SECRET          generated once; rotating it logs every user out
#   ORIGIN_VERIFY       generated once per fresh deployment; read by CloudFront
#                       and by the instance's Caddy
#   WEB_ORIGIN          written by up.sh after the distribution exists

# --- AWS -------------------------------------------------------------------
# Either a named profile from ~/.aws/credentials, ...
AWS_PROFILE=veriforge-beta
# ... or explicit keys, if you would rather not use a profile. One or the other.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Fixed in cdk.json and every script: ap-southeast-1. The CloudFront prefix
# list id and the SNS topic are region-specific.
# AWS_REGION=ap-southeast-1

# --- Providers -------------------------------------------------------------
# The production OpenRouter key. This is the one that costs money when a run
# happens, so it is the key the $20 budget is really guarding. NEVER the dev
# key: a demo key on a public URL is a bill someone else pays.
OPENROUTER_API_KEY=

# Langfuse. LANGFUSE_HOST is not optional in practice: the pinned SDK
# (langfuse<3) falls back to the EU default without it, where a JP project's
# keys fail to authenticate silently and traces simply stop arriving (KI-21).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# LiteLLM's own key, used when routing through the LiteLLM proxy.
LITELLM_MASTER_KEY=

# Encrypts provider credentials at rest in the database. There is no recovery
# if it is lost: every stored provider secret becomes unreadable.
PROVIDER_ENCRYPTION_KEY=

# Retrieval providers. All optional; without them the app degrades rather than
# failing — web search is disabled and Cohere rerank falls back to fused order.
# With no keys at all a run whose ingress picks `web` fails outright.
TAVILY_API_KEY=
BRAVE_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=

# Model ids. The defaults in apps/api/config.py are the free-tier ones, so these
# only need setting if you want a different mix.
# EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
# REFERENCE_MODEL_ID=anthropic/claude-haiku-4.5

# --- Email (SES, sandboxed) ------------------------------------------------
# There is no domain, so SES cannot be put out of the sandbox. Mail therefore
# reaches ONLY addresses verified in SES in ap-southeast-1 — in practice the
# owner's own address, so password reset works for the owner and nobody else.
# Other beta users get a fresh invite instead. See docs/ops/runbook.md.
#
# Create these in the SES console: verify your address, then "Create SMTP
# credentials". Do not put them here until that is done — the api refuses to
# start in production without them, so a deploy before then crash-loops.
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be an address verified in SES, or nothing is delivered.
SMTP_FROM=

# --- Alarms ----------------------------------------------------------------
# Where the $20 budget notification and all five CloudWatch alarms go. Also a
# CDK stack parameter, so it is passed at deploy time and never hardcoded.
ALARM_EMAIL=