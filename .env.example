# Copy to .env and fill in. Compose injects these into the api service;
# DATABASE_URL is overridden inside compose to point at the db service.
DATABASE_URL=postgresql+asyncpg://veriforge:veriforge@localhost:5432/veriforge
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=

# Auth (TRD §11)
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173
# Local compose serves plain http, so cookies can't be Secure there.
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signup control. `open` | `invite` | `closed`; the product default is
# `invite`, because forgetting to set this is the failure that leaks a
# private-beta deployment. Local compose sets `open` here so `make smoke`
# and `make acceptance` can sign up; **production must not**. In `invite`
# mode POST /auth/signup needs an invite_code, and Google sign-in follows the
# same rule for a first-time account (KI-60).
SIGNUP_MODE=open
# In-process per-IP and per-user limits on /auth/* and run creation (no Redis,
# ADR-001). They are per process and per instance — fine for one api on one
# t4g, and the first thing to revisit at scale.
# SECURITY: the limiter keys on `request.client.host`, which uvicorn rewrites
# from X-Forwarded-For only for peers in its `forwarded_allow_ips` list
# (default 127.0.0.1). Behind Caddy in another container, set forwarded_allow_ips
# to Caddy's address or every request looks like Caddy and one user can
# exhaust everyone's budget. See KI-59.
RATE_LIMIT_SIGNUP=10
RATE_LIMIT_LOGIN=10
RATE_LIMIT_RUN=60

# The local admin `make seed-admin` creates. Local only; CI never sets these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The fixed eval account `make seed-eval-user` creates and `make acceptance`
# signs in as, and which owns the eval-only corpora (KI-24). Acceptance uses it
# instead of signing up a throwaway user because a private collection is only in
# scope for the user that owns it — a signup cannot see the corpora it is being
# scored against, which is how the AW-2000 fixture ended up visible to every
# user. The books stay `visibility='shared'` and need no grant; only the
# AW-2000 seed corpus and the counterfactual corpus are private.
# EVAL_USER_EMAIL must stay in step with `EVAL_USER_EMAIL` in
# apps/api/evals/loader.py, which the runner resolves the corpus owner by.
# Local only; CI never sets these — the eval runner drives the pipeline
# in-process rather than over HTTP, so it needs no credential at all.
EVAL_USER_EMAIL=evals@example.com
EVAL_USER_PASSWORD=

# Langfuse Cloud tracing (TRD §15); empty disables
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The Langfuse region host, e.g. https://jp.cloud.langfuse.com (EU:
# https://cloud.langfuse.com). REQUIRED, not optional: the pinned SDK
# (`langfuse<3`) reads this name and nothing else, and without it it falls
# back to the EU default — where a JP project's keys fail to authenticate
# and every trace is dropped with no error anywhere (KI-21). LANGFUSE_BASE_URL
# is still accepted as an alias. compose.yaml must forward it into the api
# and worker services (see the lane C report).
LANGFUSE_HOST=

# Ingestion (TRD §9.1). Object storage is a local dir at Stage 1.
OBJECT_STORAGE_DIR=.data/objects
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-large
# Procrastinate connects with psycopg, not asyncpg — plain postgresql:// URL.
PROCRASTINATE_CONNINFO=postgresql://veriforge:veriforge@localhost:5432/veriforge

# Retrieval (TRD §9.2-9.4); empty disables Cohere rerank / web search
COHERE_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Models. Jev is unchanged (System One). Every other LLM call runs on a free
# OpenRouter :free id — run `make seed-models` to resolve the current free pool
# and wire the role bindings. Free ids are rate-limited per minute and per day.
FALLBACK_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
LLM_MAX_RETRIES=4
