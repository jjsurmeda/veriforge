# syntax=docker/dockerfile:1

# One image for the api and both workers. They differ only in `command`, which
# is set per service in compose.prod.yaml — not by building anything here.
#
# Item 0 verified `ghcr.io/astral-sh/uv:python3.12-bookworm-slim` and
# `python:3.12-slim-bookworm` both publish linux/arm64, so this builds
# natively on the owner's Mac for a t4g instance.

ARG PYTHON_VERSION=3.12

# --- dependency layer -------------------------------------------------------
# pyproject.toml and uv.lock only, so this layer is reused until a dependency
# actually changes. `--frozen` means the lockfile is the source of truth: the
# build fails rather than silently re-resolving, which is the whole point of
# deploying a pinned commit.
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS builder

# UV_LINK_MODE=copy: the venv is copied into the runtime stage below, and
# hardlinks do not survive that boundary.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# --- application layer ------------------------------------------------------
COPY . .
# No --no-dev this time: the app itself must be installed. Dev dependencies
# stay out (ruff/mypy/pytest are not in a production image).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# --- runtime ----------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

# Non-root. The uid is fixed so a bind-mounted EBS volume can be chowned to it
# in user data; the api writes nothing outside /data.
RUN groupadd --gid 10001 vf \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin vf

WORKDIR /app
COPY --from=builder --chown=vf:vf /app/.venv /app/.venv
COPY --chown=vf:vf . /app

# Objects and document files land here; the compose volume maps it to the EBS
# mount. Created and owned up front so the non-root user can write to it.
RUN mkdir -p /data/objects && chown -R vf:vf /data

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER vf
EXPOSE 8000

# /healthz via the stdlib, because slim has no curl. It is the endpoint the
# compose healthcheck and `up.sh` both gate on, and it reports db, breaker and
# jev state rather than just process liveness.
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 \
  CMD ["python", "-c", "import sys,urllib.request; \
sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4).status == 200 else 1)"]

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]